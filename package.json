{
  "name": "opencode-mgr",
  "version": "1.7.0",
  "description": "Cross-Platform GUI & MCP Management Suite for OpenCode Configuration, Models/Providers, Per-Agent Plugins, Multi-Host Nodes, and SQLite Maintenance",
  "main": "app.mjs",
  "type": "module",
  "scripts": {
    "start": "node app.mjs",
    "server": "node server.mjs",
    "app": "node app.mjs --app",
    "mcp": "node mcp-server.mjs"
  },
  "bin": {
    "opencode-mgr": "./app.mjs",
    "opencodemgr": "./app.mjs",
    "opencodemgr-mcp": "./mcp-server.mjs"
  },
  "files": [
    "app.mjs",
    "server.mjs",
    "mcp-server.mjs",
    "i18n.mjs",
    "db_helper.py",
    "nodes.example.json",
    "public",
    "src",
    "README.md",
    "README.zh-TW.md",
    "README.zh-CN.md",
    "README.ja-JP.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dardeaw/OpenCodeMgr.git"
  },
  "homepage": "https://github.com/dardeaw/OpenCodeMgr#readme",
  "bugs": {
    "url": "https://github.com/dardeaw/OpenCodeMgr/issues"
  },
  "keywords": [
    "opencode",
    "manager",
    "opencodemgr",
    "mcp",
    "mcp-server",
    "agents",
    "plugins",
    "providers",
    "models",
    "prompts",
    "sqlite"
  ],
  "author": "dardeaw",
  "license": "MIT"
}
