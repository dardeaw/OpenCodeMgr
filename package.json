{
  "name": "opencode-mgr",
  "version": "1.7.0",
  "description": "Cross-Platform GUI & MCP Management Suite for OpenCode Configuration, Models/Providers, Per-Agent Plugins, Multi-Host Nodes, and SQLite Maintenance",
  "main": "app.mjs",
  "type": "module",
  "scripts": {
    "start": "node app.mjs",
    "server": "node server.mjs",
    "app": "node app.mjs --app",
    "mcp": "node mcp-server.mjs"
  },
  "bin": {
    "opencodemgr": "./app.mjs",
    "opencodemgr-mcp": "./mcp-server.mjs"
  },
  "keywords": [
    "opencode",
    "manager",
    "opencodemgr",
    "mcp",
    "mcp-server",
    "agents",
    "plugins",
    "providers",
    "models",
    "prompts",
    "sqlite"
  ],
  "author": "dardeaw",
  "license": "MIT"
}
